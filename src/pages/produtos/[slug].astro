---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LojaLogo from '../../components/LojaLogo.astro';
import FAQ from '../../components/FAQ.astro';

export async function getStaticPaths() {
  const produtos = await getCollection('produtos');
  return produtos.map(p => ({
    params: { slug: p.id },
    props: { produto: p },
  }));
}

const { produto } = Astro.props;
const d = produto.data;

const SITE_URL = 'https://bicicletasergometricas.com';
const pageUrl = `${SITE_URL}/produtos/${produto.id}/`;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${pageUrl}#product`,
  name: d.name,
  description: d.description,
  category: `Bicicleta ergométrica ${d.tipo}`,
  brand: { '@type': 'Brand', name: d.marca },
  ...(d.image ? { image: `${SITE_URL}${d.image}` } : {}),
  additionalProperty: Object.entries(d.especificacoes ?? {}).map(([name, value]) => ({
    '@type': 'PropertyValue', name, value,
  })),
  offers: d.ofertas.map((o) => ({
    '@type': 'Offer',
    url: o.url,
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: o.loja },
  })),
};

const breadcrumbs = [
  { name: 'Produtos', url: '/produtos/' },
  { name: d.name, url: `/produtos/${produto.id}/` },
];
---

<Layout
  title={`${d.name} — Ficha Completa`}
  description={d.description}
  breadcrumbs={breadcrumbs}
  faqItems={d.faqItems ?? []}
  isArticle={false}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(productSchema)} />

  <div class="produto-detalhe container">

    <div class="detalhe-grid">

      <div class="detalhe-img-wrap">
        {d.topPick && <span class="badge-top">Nossa Indicação</span>}
        {d.badge && <span class="badge-destaque">{d.badge}</span>}
        {d.image ? (
          <img
            src={d.image}
            alt={d.imageAlt ?? d.name}
            class="detalhe-img"
            width="520"
            height="360"
          />
        ) : (
          <div class="detalhe-img-placeholder" aria-hidden="true">
            <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="60" cy="60" r="42" stroke="#52B788" stroke-width="4" fill="none"/>
              <circle cx="60" cy="60" r="9" fill="#52B788"/>
              <line x1="60" y1="18" x2="60" y2="36" stroke="#52B788" stroke-width="4" stroke-linecap="round"/>
              <line x1="60" y1="84" x2="60" y2="102" stroke="#52B788" stroke-width="4" stroke-linecap="round"/>
              <line x1="18" y1="60" x2="36" y2="60" stroke="#52B788" stroke-width="4" stroke-linecap="round"/>
              <line x1="84" y1="60" x2="102" y2="60" stroke="#52B788" stroke-width="4" stroke-linecap="round"/>
            </svg>
          </div>
        )}
      </div>

      <div class="detalhe-info">
        <span class="detalhe-marca">{d.marca}</span>
        <h1 class="detalhe-nome">{d.name}</h1>

        <p class="detalhe-desc">{d.descricaoLonga}</p>

        {d.features && d.features.length > 0 && (
          <ul class="detalhe-features">
            {d.features.map(f => <li>✓ {f}</li>)}
          </ul>
        )}

        <div class="detalhe-cta-box">
          <span class="detalhe-cta-titulo">Onde comprar</span>
          <div class="detalhe-ofertas">
            {d.ofertas.map((o) => {
              const prep = o.loja === 'Mercado Livre' ? 'no' : 'na';
              const slug = o.loja === 'Mercado Livre' ? 'ml' : o.loja === 'Shopee' ? 'shopee' : 'amazon';
              return (
                <a
                  href={o.url}
                  target="_blank"
                  rel="noopener nofollow sponsored"
                  class={`btn-loja btn-${slug}`}
                  aria-label={`Ver ${d.name} ${prep} ${o.loja}`}
                >
                  <LojaLogo loja={o.loja} />
                  <svg class="btn-loja-arrow" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                    <path d="M7 17 L17 7"/><path d="M8 7 h9 v9"/>
                  </svg>
                </a>
              );
            })}
          </div>
        </div>

        <p class="detalhe-aviso">
          * Este site participa dos programas de afiliados da Amazon e do Mercado Livre. Ao comprar por estes links podemos receber uma comissão, sem custo adicional para você.
        </p>
      </div>
    </div>

    {(d.pros?.length || d.contras?.length) && (
      <section class="detalhe-bloco">
        <h2>Prós e contras</h2>
        <div class="proscontras">
          {d.pros?.length && (
            <div class="pc-col pc-pro">
              <h3>A favor</h3>
              <ul>{d.pros.map((p) => <li>{p}</li>)}</ul>
            </div>
          )}
          {d.contras?.length && (
            <div class="pc-col pc-con">
              <h3>Contra</h3>
              <ul>{d.contras.map((c) => <li>{c}</li>)}</ul>
            </div>
          )}
        </div>
      </section>
    )}

    {d.problemasRelatados && (
      <section class="detalhe-bloco">
        <h2>Problemas relatados e uso a longo prazo</h2>
        <p>{d.problemasRelatados}</p>
      </section>
    )}

    {(d.paraQuem || d.naoIndicadoPara) && (
      <section class="detalhe-bloco">
        <h2>Para quem é</h2>
        {d.paraQuem && <p><strong>Indicada para:</strong> {d.paraQuem}</p>}
        {d.naoIndicadoPara && <p><strong>Evite se:</strong> {d.naoIndicadoPara}</p>}
      </section>
    )}

    {d.especificacoes && Object.keys(d.especificacoes).length > 0 && (
      <section class="detalhe-specs">
        <h2>Especificações Técnicas</h2>
        <table class="specs-table">
          <tbody>
            {Object.entries(d.especificacoes).map(([k, v]) => (
              <tr>
                <th>{k}</th>
                <td>{v}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    <div class="detalhe-back">
      <a href="/produtos/">&larr; Ver todos os produtos</a>
    </div>

  </div>

  {d.faqItems && d.faqItems.length > 0 && (
    <FAQ items={d.faqItems} title={`Perguntas frequentes sobre a ${d.name}`} />
  )}
</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .detalhe-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin-bottom: 3rem;
  }
  @media (max-width: 768px) {
    .detalhe-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  .detalhe-img-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #e5e7eb;
  }
  .badge-top {
    position: absolute; top: 12px; left: 12px;
    background: #2D6A4F; color: #fff;
    font-size: 0.72rem; font-weight: 700;
    padding: 0.25rem 0.7rem; border-radius: 4px;
    text-transform: uppercase; z-index: 2;
  }
  .badge-destaque {
    position: absolute; top: 12px; right: 12px;
    background: #F4721B; color: #fff;
    font-size: 0.72rem; font-weight: 700;
    padding: 0.25rem 0.7rem; border-radius: 4px; z-index: 2;
  }
  .detalhe-img {
    width: 100%; aspect-ratio: 16/11; object-fit: cover; display: block;
  }
  .detalhe-img-placeholder {
    width: 100%; aspect-ratio: 16/11;
    background: #f0fdf4;
    display: flex; align-items: center; justify-content: center;
  }
  .detalhe-img-placeholder svg { width: 100px; height: 100px; opacity: 0.35; }
  .detalhe-info { display: flex; flex-direction: column; gap: 0.75rem; }
  .detalhe-marca {
    font-size: 0.75rem; font-weight: 700;
    color: #52B788; text-transform: uppercase; letter-spacing: 0.06em;
  }
  .detalhe-nome {
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 800; line-height: 1.25;
    color: #111827; margin: 0;
    font-family: Inter, sans-serif;
  }
  .detalhe-rating {
    display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;
  }
  .estrelas { color: #f59e0b; font-size: 1rem; }
  .rating-valor { font-weight: 700; color: #374151; }
  .rating-count { color: #9ca3af; }
  .detalhe-desc {
    font-size: 0.95rem; color: #4b5563; line-height: 1.7; margin: 0;
  }
  .detalhe-features {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 0.4rem;
  }
  .detalhe-features li {
    font-size: 0.88rem; color: #374151;
    display: flex; align-items: flex-start; gap: 0.4rem;
  }
  .detalhe-cta-box {
    background: #f9fafb; border: 1px solid #e5e7eb;
    border-radius: 10px; padding: 1.1rem;
    display: flex; flex-direction: column; gap: 0.7rem;
  }
  .detalhe-cta-titulo {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; color: #6b7280;
  }
  .detalhe-ofertas { display: flex; flex-direction: column; gap: 0.5rem; }
  .detalhe-aviso {
    font-size: 0.72rem; color: #9ca3af; line-height: 1.5; margin: 0;
  }
  .detalhe-specs { margin-bottom: 2.5rem; }
  .detalhe-specs h2 {
    font-size: 1.2rem; font-weight: 800;
    color: #111827; margin-bottom: 1rem;
    font-family: Inter, sans-serif;
  }
  .specs-table {
    width: 100%; border-collapse: collapse;
    font-size: 0.88rem;
  }
  .specs-table tr { border-bottom: 1px solid #f3f4f6; }
  .specs-table tr:last-child { border-bottom: none; }
  .specs-table th {
    text-align: left; padding: 0.6rem 0.75rem;
    color: #6b7280; font-weight: 600; width: 45%;
    background: #f9fafb;
  }
  .specs-table td {
    padding: 0.6rem 0.75rem;
    color: #111827; font-weight: 500;
  }
  .detalhe-back { margin-top: 1rem; }
  .detalhe-back a {
    color: #2D6A4F; font-size: 0.88rem;
    font-weight: 600; text-decoration: none;
  }
  .detalhe-back a:hover { text-decoration: underline; }

  .detalhe-bloco { margin-bottom: 2.5rem; }
  .detalhe-bloco h2 {
    font-size: 1.2rem; font-weight: 800; color: #111827;
    margin-bottom: 1rem; font-family: Inter, sans-serif;
  }
  .detalhe-bloco p { font-size: 0.95rem; color: #374151; line-height: 1.7; margin: 0 0 0.75rem; }
  .proscontras { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  @media (max-width: 640px) { .proscontras { grid-template-columns: 1fr; } }
  .pc-col h3 {
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;
    margin: 0 0 0.5rem;
  }
  .pc-pro h3 { color: #2e7d55; }
  .pc-con h3 { color: #b1442f; }
  .pc-col ul { margin: 0; padding-left: 1.1rem; }
  .pc-col li { font-size: 0.9rem; color: #374151; line-height: 1.55; margin: 0.3rem 0; }
</style>
