---
/**
 * Google Analytics 4 com Consent Mode v2 (LGPD).
 * Measurement ID: G-KMSB0MEHRZ
 *
 * O gtag carrega sempre (em produção), mas com analytics_storage = 'denied'
 * por padrão. Nenhum cookie de análise é gravado até o visitante aceitar
 * no banner (src/components/CookieConsent.astro), que chama
 * gtag('consent','update',{ analytics_storage: 'granted' }).
 * Só conta tráfego de produção — dev/preview ficam de fora.
 */
---

{import.meta.env.PROD && (
  <Fragment>
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      var stored = null;
      try { stored = localStorage.getItem('cookie-consent'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: stored === 'granted' ? 'granted' : 'denied',
        wait_for_update: 500
      });
      gtag('config', 'G-KMSB0MEHRZ', { anonymize_ip: true });
    `}></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KMSB0MEHRZ"></script>
  </Fragment>
)}
