---
// src/components/LojaLogo.astro
// Logo simplificada de cada loja para os botões de afiliado.
type Loja = "Amazon" | "Mercado Livre" | "Shopee";
interface Props { loja: Loja; }
const { loja } = Astro.props;
---

{loja === "Amazon" && (
  <svg class="loja-logo loja-logo-amazon" viewBox="0 0 120 40" role="img" aria-label="Amazon" xmlns="http://www.w3.org/2000/svg">
    <text x="2" y="26" font-family="'Trebuchet MS', Verdana, Arial, sans-serif" font-size="28" font-weight="700" letter-spacing="-1.7" fill="currentColor">amazon</text>
    <path d="M14 31 q 45 15 90 -4" fill="none" stroke="#FF9900" stroke-width="3.6" stroke-linecap="round"/>
    <path d="M99 23 l 9 1 l -5 6.5 z" fill="#FF9900"/>
  </svg>
)}

{loja === "Mercado Livre" && (
  <svg class="loja-logo loja-logo-ml" viewBox="0 0 210 40" role="img" aria-label="Mercado Livre" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
    <text x="105" y="27" text-anchor="middle" font-family="'Trebuchet MS', Verdana, Arial, sans-serif" font-size="25" font-weight="700" letter-spacing="-0.5" fill="#2D3277">Mercado Livre</text>
  </svg>
)}

{loja === "Shopee" && (
  <svg class="loja-logo loja-logo-shopee" viewBox="0 0 130 40" role="img" aria-label="Shopee" xmlns="http://www.w3.org/2000/svg">
    <path d="M6 14 h18 l-1.6 19 a3 3 0 0 1 -3 2.8 h-8.8 a3 3 0 0 1 -3 -2.8 z" fill="none" stroke="currentColor" stroke-width="2.6"/>
    <path d="M10.5 15 a4.5 6 0 0 1 9 0" fill="none" stroke="currentColor" stroke-width="2.6"/>
    <text x="32" y="28" font-family="'Trebuchet MS', Verdana, Arial, sans-serif" font-size="22" font-weight="800" letter-spacing="-0.5" fill="currentColor">Shopee</text>
  </svg>
)}

<style>
  .loja-logo { height: 1.4rem; width: auto; display: block; }
  .loja-logo-amazon { color: #ffffff; }
  .loja-logo-ml { color: #2D3277; }
  .loja-logo-shopee { color: #ffffff; }
</style>
